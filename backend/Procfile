web: uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --timeout-keep-alive 120
worker: CELERY_WORKER=1 celery -A app.core.celery_app worker --pool=prefork --queues=celery,trades,alerts,reports --loglevel=INFO
beat: CELERY_WORKER=1 celery -A app.core.celery_app beat --scheduler=redbeat.RedBeatScheduler --loglevel=INFO
